<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    >

  <genericsetup:upgradeSteps
      profile="kitconcept.core:multilingual"
      source="1000"
      destination="1001"
      >
    <genericsetup:upgradeDepends
        title="Update LRF FTI to only have summary_view in view_methods"
        import_steps="typeinfo"
        />
  </genericsetup:upgradeSteps>

  <genericsetup:upgradeSteps
      profile="kitconcept.core:base"
      source="20260706001"
      destination="20260728001"
      >
    <genericsetup:upgradeStep
        title="Upgrade multilingual profile to version 1001 if already installed"
        handler=".upgrade_multilingual"
        />
  </genericsetup:upgradeSteps>

</configure>
