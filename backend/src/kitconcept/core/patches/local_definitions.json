{
  "field-scope": {
    "type": "array",
    "title": "Scopes",
    "minItems": 1,
    "uniqueItems": true
  },
  "identity-keycloak": {
    "type": "object",
    "properties": {
      "identity-server_url": {
        "type": "string",
        "title": "Server URL"
      },
      "identity-realm_name": {
        "type": "string",
        "title": "Realm"
      },
      "identity-client_id": {
        "type": "string",
        "title": "Client ID"
      },
      "identity-client_secret": {
        "type": "string",
        "title": "Client Secret"
      },
      "identity-site-url": {
        "type": "string",
        "title": "Public URL of your site",
        "description": "Please inform the address this site will be available. Leave it empty to use the address of the request."
      },
      "identity-scope": {
        "$ref": "#/definitions/field-scope",
        "items": {
          "type": "string",
          "enum": [
            "openid",
            "profile",
            "email"
          ]
        }
      }
    },
    "required": [
      "identity-server_url",
      "identity-realm_name",
      "identity-client_id",
      "identity-client_secret"
    ]
  },
